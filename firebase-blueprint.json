    "FundTransaction": {
      "title": "FundTransaction",
      "description": "Verified member fund contribution or receipted expense disbursement managed exclusively by admins.",
      "type": "object",
      "properties": {
        "memberUid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "memberName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "memberCadetNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24,
          "pattern": "^[A-Za-z0-9\\-\\/ ]*$"
        },
        "memberBatch": { "type": "string", "minLength": 0, "maxLength": 32 },
        "entryType": { "type": "string", "enum": ["contribution", "disbursement"] },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["BDT"] },
        "category": {
          "type": "string",
          "enum": [
            "Monthly Subscription",
            "Annual Membership Fee",
            "Welfare Fund",
            "Cadet Support",
            "Dhaka Office Fund",
            "Event / Reunion",
            "Operational Expense",
            "Other"
          ]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Bank Transfer", "bKash", "Nagad", "Rocket", "Cash", "Cheque"]
        },
        "bankAccountLabel": { "type": "string", "minLength": 0, "maxLength": 120 },
        "referenceNumber": { "type": "string", "minLength": 0, "maxLength": 80 },
        "transactionDateTime": {
          "type": "string",
          "minLength": 16,
          "maxLength": 25,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?Z?)?$"
        },
        "notes": { "type": "string", "minLength": 0, "maxLength": 500 },
        "receiptDataUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150000,
          "description": "Compressed receipt image data URI or URL. Mandatory for expense disbursements."
        },
        "isPublished": { "type": "boolean" },
        "recordedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recordedByName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "recordedByEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "updatedByEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "memberUid",
        "memberName",
        "memberCadetNumber",
        "memberBatch",
        "entryType",
        "amount",
        "currency",
        "category",
        "paymentMethod",
        "bankAccountLabel",
        "referenceNumber",
        "transactionDateTime",
        "notes",
        "receiptDataUrl",
        "isPublished",
        "recordedByUid",
        "recordedByName",
        "recordedByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
