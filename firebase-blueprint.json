{
  "entities": {
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Publicly visible (to signed-in BMASA members) maritime credential and directory record. Excludes sensitive PII (Passport, Bank/MFS, NOK, Email, Phone).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "photoUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100000
        },
        "cadetNumber": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^[A-Za-z0-9\\-\\/ ]+$"
        },
        "batch": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "department": {
          "type": "string",
          "enum": ["Nautical", "Marine Engineering", "Instructors"]
        },
        "cdcNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9\\-\\/ ]*$"
        },
        "sidNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9\\-\\/ ]*$"
        },
        "currentRank": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "availabilityStatus": {
          "type": "string",
          "enum": ["Available for Sea", "Onboard", "On Leave", "Shore-Based"]
        },
        "bloodGroup": {
          "type": "string",
          "enum": ["", "A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-"]
        },
        "city": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "country": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "cvUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "memberSerial": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9\\-\\/ ]+$"
        },
        "isVerified": {
          "type": "boolean"
        },
        "isPublicDirectory": {
          "type": "boolean"
        },
        "voyageCount": {
          "type": "integer"
        },
        "contactEmail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "contactPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "additionalInfo": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "photoUrl",
        "cadetNumber",
        "batch",
        "department",
        "cdcNumber",
        "currentRank",
        "availabilityStatus",
        "bloodGroup",
        "city",
        "country",
        "cvUrl",
        "memberSerial",
        "isVerified",
        "isPublicDirectory",
        "voyageCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "PrivateVault": {
      "title": "PrivateVault",
      "description": "Strictly confidential PII vault isolated to document owner and verified BMASA admins. Contains contact details, Passport No., welfare bank/MFS info, certificate expiry dates, and Emergency NOK.",
      "type": "object",
