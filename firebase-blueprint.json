          "type": "string",
          "minLength": 0,
          "maxLength": 140
        },
        "passportIssueDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
        },
        "bankAccountHolder": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "bankName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "bankBranch": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "bankAccountNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "bankRoutingNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "mfsNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "passportExpiry": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
        },
        "cdcIssueDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
        },
        "cdcExpiry": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
        },
        "medicalExpiry": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
        },
        "stcwCocExpiry": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
        },
        "academicQualifications": {
          "type": "array",
          "description": "Bounded list (max 12) of academic qualifications (SSC, HSC, Academy, B.Sc., etc.)."
        },
        "nokName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "nokRelation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "nokPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "nokCity": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "phone",
        "whatsapp",
        "passportNumber",
        "bankAccountHolder",
        "bankName",
        "bankBranch",
        "bankAccountNumber",
        "bankRoutingNumber",
        "mfsNumber",
        "passportExpiry",
        "cdcExpiry",
        "medicalExpiry",
        "stcwCocExpiry",
        "nokName",
        "nokRelation",
        "nokPhone",
        "nokCity",
        "createdAt",
        "updatedAt"
      ]
    },
