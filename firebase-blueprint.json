  "firestore": {
    "/public_profiles/{memberId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Signed-in readable public directory profiles (non-PII maritime credentials, Blood Group, City/Country, and optional opt-in contact Email/Phone); editable only by owner (excluding isVerified) or verified admin."
    },
    "/public_profiles/{memberId}/voyages/{voyageId}": {
      "schema": { "$ref": "#/entities/VoyageRecord" },
      "description": "Sea service voyage records linked to a parent PublicProfile."
    },
    "/private_vault/{memberId}": {
      "schema": { "$ref": "#/entities/PrivateVault" },
      "description": "Strictly owner- and admin-only confidential PII vault (Email, Phone, WhatsApp, Passport No., Bank/MFS payout info, Certificate Expiry dates, Emergency NOK)."
    },
    "/private_vault/{memberId}/cop_certificates/{certId}": {
      "schema": { "$ref": "#/entities/CopCertificate" },
      "description": "Strictly owner- and admin-only STCW Certificate of Proficiency (COP) expiry records nested under private_vault."
    },
    "/directory_profiles/{memberId}": {
      "schema": { "$ref": "#/entities/DirectoryProfile" },
      "description": "Legacy signed-in readable directory profiles retained for backward compatibility."
    },
    "/directory_profiles/{memberId}/voyages/{voyageId}": {
      "schema": { "$ref": "#/entities/VoyageRecord" },
      "description": "Legacy voyage records subcollection retained for backward compatibility."
    },
    "/member_private/{memberId}": {
      "schema": { "$ref": "#/entities/MemberPrivateContact" },
      "description": "Legacy private contact details retained for backward compatibility."
    },
    "/job_postings/{jobId}": {
      "schema": { "$ref": "#/entities/JobPosting" },
      "description": "Official cadetship/officer job postings readable by signed-in members; written exclusively by admins."
    },
    "/portal_stats/{statId}": {
      "schema": { "$ref": "#/entities/PortalStats" },
      "description": "Public aggregate statistics document (/portal_stats/summary) for the landing page."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Delegated admin registry keyed by sanitized lowercased email; listed and modified exclusively by Main Admin razibuddin247@gmail.com."
    },
    "/bank_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/BankAccount" },
      "description": "Official BMASA bank & mobile financial accounts readable by signed-in members; managed exclusively by admins."
    },
    "/fund_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/FundTransaction" },
      "description": "Transparent per-member fund contribution and receipted expense ledger; readable by signed-in members and written exclusively by admins."
    },
    "/payment_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/PaymentSubmission" },
      "description": "Member-submitted subscription & donation payment proofs awaiting treasury verification before posting to /fund_transactions."
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/NoticeItem" },
      "description": "Official BMASA circulars & announcements readable by signed-in members; managed exclusively by admins."
    },
    "/mentorship_posts/{postId}": {
      "schema": { "$ref": "#/entities/MentorshipPost" },
      "description": "CoC Exam & Cadet Mentorship posts readable by signed-in members; created by verified alumni/admins and editable by author or admin."
    },
    "/crewing_companies/{companyId}": {
      "schema": { "$ref": "#/entities/CrewingCompany" },
      "description": "Shipping Company & Manning Agent entries readable by signed-in members; created by verified alumni/admins and editable by author or admin."
    },
    "/dhaka_office_milestones/{itemId}": {
      "schema": { "$ref": "#/entities/DhakaRoadmapItem" },
      "description": "Executive Committee roster & Dhaka Office fundraising milestones readable by signed-in members; managed exclusively by admins."
    },
    "/gallery_photos/{photoId}": {
      "schema": { "$ref": "#/entities/GalleryPhoto" },
      "description": "BMASA batch photo gallery archive readable by signed-in members; managed exclusively by admins."
    }
  }
