          (isOwner(memberId) || isAdmin()) &&
          exists(/databases/$(database)/documents/directory_profiles/$(memberId));
      }
    }

    // -------------------------------------------------------------------------
    // Legacy Collection: /member_private/{memberId} (Retained for Migration)
    // -------------------------------------------------------------------------
    match /member_private/{memberId} {
      allow get: if isValidId(memberId) && (isOwner(memberId) || isAdmin());
      allow list: if false;

      allow create: if isValidId(memberId) &&
        isVerifiedUser() &&
        isValidPrivateContact(incoming()) &&
        incoming().uid == memberId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isOwner(memberId) || isAdmin());

      allow update: if isValidId(memberId) &&
        isVerifiedUser() &&
        isValidPrivateContact(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(memberId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'email',
              'phone',
              'whatsapp',
              'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'email',
              'phone',
              'whatsapp',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(memberId) && isVerifiedUser() && (isOwner(memberId) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Collection: /job_postings/{jobId} (Admin-Only Writes; Member Read-Only)
    // -------------------------------------------------------------------------
    match /job_postings/{jobId} {
      allow get: if isValidId(jobId) && isSignedIn() && (
        existing().status == 'open' || isAdmin()
      );

      allow list: if isSignedIn() && existing().status == 'open';

      allow create: if isValidId(jobId) &&
        isVerifiedUser() &&
        isValidJobPosting(incoming()) &&
        incoming().posterUid == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isValidId(jobId) &&
        isVerifiedUser() &&
        isValidJobPosting(incoming()) &&
        incoming().posterUid == existing().posterUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'companyName',
              'rankNeeded',
              'vesselType',
              'contactInfo',
              'notes',
              'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isValidId(jobId) && isVerifiedUser() && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: /portal_stats/{statId} (Public Aggregate Counters Only)
    // -------------------------------------------------------------------------
    match /portal_stats/{statId} {
      allow get: if isValidId(statId) && statId == 'summary';
      allow list: if false;
      allow create, update: if isValidId(statId) &&
        statId == 'summary' &&
        isValidPortalStats(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: /admins/{adminId} (Exclusively Managed by Main Admin)
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (
        isMainAdmin() ||
        isOwner(adminId) ||
        (
          isVerifiedUser() &&
          request.auth.token.email is string &&
          adminId == emailToAdminDocId(request.auth.token.email)
        )
      );

      allow list: if isMainAdmin() && existing().role == 'admin';

      allow create: if isValidId(adminId) &&
        isMainAdmin() &&
        isValidAdminEntry(incoming()) &&
        adminId == emailToAdminDocId(incoming().email) &&
        incoming().addedByEmail == 'razibuddin247@gmail.com' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(adminId) &&
        isMainAdmin() &&
        isValidAdminEntry(incoming()) &&
        incoming().email == existing().email &&
        incoming().addedByEmail == existing().addedByEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if isValidId(adminId) && isMainAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: /bank_accounts/{accountId} (Official BMASA Bank Details)
    // -------------------------------------------------------------------------
    match /bank_accounts/{accountId} {
      allow get: if isValidId(accountId) && isSignedIn() && (
        existing().isActive == true || isAdmin()
      );

      allow list: if isSignedIn() && existing().isActive == true;

      allow create: if isValidId(accountId) &&
        isVerifiedUser() &&
        isValidBankAccount(incoming()) &&
        incoming().addedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isValidId(accountId) &&
        isVerifiedUser() &&
        isValidBankAccount(incoming()) &&
        incoming().addedByUid == existing().addedByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'bankName',
          'accountName',
          'accountNumber',
          'branchName',
          'routingNumber',
          'accountType',
          'currency',
          'notes',
          'isActive',
          'updatedAt'
        ]);

      allow delete: if isValidId(accountId) && isVerifiedUser() && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: /fund_transactions/{transactionId} (Payments & Receipted Expenses)
    // -------------------------------------------------------------------------
    match /fund_transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isSignedIn() && (
        existing().isPublished == true || isAdmin()
      );

      allow list: if isSignedIn() && existing().isPublished == true;

      allow create: if isValidId(transactionId) &&
        isVerifiedUser() &&
        isValidFundTransaction(incoming()) &&
        incoming().recordedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        (
          incoming().memberUid == '' ||
          memberProfileExists(incoming().memberUid)
        );

      allow update: if isValidId(transactionId) &&
        isVerifiedUser() &&
        isValidFundTransaction(incoming()) &&
        incoming().recordedByUid == existing().recordedByUid &&
        (!('updatedByUid' in incoming()) || incoming().updatedByUid == request.auth.uid) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'memberUid',
          'memberName',
          'memberCadetNumber',
          'memberBatch',
          'entryType',
          'amount',
          'currency',
          'category',
          'paymentMethod',
          'bankAccountLabel',
          'referenceNumber',
          'transactionDateTime',
          'notes',
          'receiptDataUrl',
          'isPublished',
          'updatedByUid',
          'updatedByName',
          'updatedByEmail',
          'updatedAt'
        ]) &&
        (
          incoming().memberUid == '' ||
          memberProfileExists(incoming().memberUid)
        );

      allow delete: if isValidId(transactionId) && isVerifiedUser() && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: /payment_submissions/{submissionId} (Member Payment Proofs)
    // -------------------------------------------------------------------------
    match /payment_submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (
        existing().memberUid == request.auth.uid || isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().memberUid == request.auth.uid || isMainAdmin()
      );

      allow create: if isValidId(submissionId) &&
        isVerifiedUser() &&
        isValidPaymentSubmission(incoming()) &&
        incoming().memberUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().adminNotes == '' &&
        incoming().reviewedByUid == '' &&
        incoming().reviewedByName == '' &&
        incoming().postedTransactionId == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        memberProfileExists(request.auth.uid);

      allow update: if isValidId(submissionId) &&
        isVerifiedUser() &&
        isAdmin() &&
        isValidPaymentSubmission(incoming()) &&
        incoming().memberUid == existing().memberUid &&
        incoming().memberName == existing().memberName &&
        incoming().memberCadetNumber == existing().memberCadetNumber &&
        incoming().memberBatch == existing().memberBatch &&
        incoming().amount == existing().amount &&
        incoming().currency == existing().currency &&
        incoming().category == existing().category &&
        incoming().paymentMethod == existing().paymentMethod &&
        incoming().bankAccountLabel == existing().bankAccountLabel &&
        incoming().referenceNumber == existing().referenceNumber &&
        incoming().transactionDateTime == existing().transactionDateTime &&
        incoming().notes == existing().notes &&
        incoming().receiptDataUrl == existing().receiptDataUrl &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'adminNotes',
          'reviewedByUid',
          'reviewedByName',
          'postedTransactionId',
          'updatedAt'
        ]);

      allow delete: if isValidId(submissionId) && isVerifiedUser() && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: /notices/{noticeId} (Official BMASA Circulars - Admin Managed)
    // -------------------------------------------------------------------------
    match /notices/{noticeId} {
      allow get: if isValidId(noticeId) && isSignedIn() && (
        existing().isPublished == true || isAdmin()
      );

      allow list: if isSignedIn() && existing().isPublished == true;

      allow create: if isValidId(noticeId) &&
        isVerifiedUser() &&
        isValidNoticeItem(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isValidId(noticeId) &&
        isVerifiedUser() &&
        isValidNoticeItem(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'noticeType',
          'category',
          'body',
          'attachmentUrl',
          'isPinned',
          'isPublished',
          'updatedAt'
        ]);

      allow delete: if isValidId(noticeId) && isVerifiedUser() && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: /mentorship_posts/{postId} (CoC Exam & Mentorship Hub)
    // -------------------------------------------------------------------------
    match /mentorship_posts/{postId} {
      allow get: if isValidId(postId) && isSignedIn() && (
        existing().isPublished == true || isOwner(existing().authorUid) || isAdmin()
      );

      allow list: if isSignedIn() && existing().isPublished == true;

      allow create: if isValidId(postId) &&
        isVerifiedUser() &&
        isVerifiedMember() &&
        isValidMentorshipPost(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(postId) &&
        isVerifiedUser() &&
        isValidMentorshipPost(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isOwner(existing().authorUid) || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'examTrack',
          'title',
          'adviceBody',
          'resourceUrl',
          'isPublished',
          'updatedAt'
        ]);

      allow delete: if isValidId(postId) && isVerifiedUser() && (isOwner(existing().authorUid) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Collection: /crewing_companies/{companyId} (Verified Shipping & Manning Directory)
    // -------------------------------------------------------------------------
    match /crewing_companies/{companyId} {
      allow get: if isValidId(companyId) && isSignedIn() && (
        existing().isPublished == true || isOwner(existing().authorUid) || isAdmin()
      );

      allow list: if isSignedIn() && existing().isPublished == true;

      allow create: if isValidId(companyId) &&
        isVerifiedUser() &&
        isVerifiedMember() &&
        isValidCrewingCompany(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(companyId) &&
        isVerifiedUser() &&
        isValidCrewingCompany(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isOwner(existing().authorUid) || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'companyName',
          'dosLicense',
          'fleetType',
          'cadetIntakeStatus',
          'contactEmail',
          'alumniNotes',
          'isPublished',
          'updatedAt'
        ]);

      allow delete: if isValidId(companyId) && isVerifiedUser() && (isOwner(existing().authorUid) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Collection: /dhaka_office_milestones/{itemId} (Committee & Dhaka Office Roadmap)
    // -------------------------------------------------------------------------
    match /dhaka_office_milestones/{itemId} {
      allow get: if isValidId(itemId) && isSignedIn() && (
        existing().isPublished == true || isAdmin()
      );

      allow list: if isSignedIn() && existing().isPublished == true;

      allow create: if isValidId(itemId) &&
        isVerifiedUser() &&
        isValidDhakaRoadmapItem(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isValidId(itemId) &&
        isVerifiedUser() &&
        isValidDhakaRoadmapItem(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'itemType',
          'title',
          'subtitle',
          'personName',
          'personBatch',
          'personCadetNo',
          'status',
          'targetAmountBdt',
          'raisedAmountBdt',
          'displayOrder',
          'notes',
          'isPublished',
          'updatedByUid',
          'updatedAt'
        ]);

      allow delete: if isValidId(itemId) && isVerifiedUser() && isAdmin();
    }

    // -------------------------------------------------------------------------
    // Collection: /gallery_photos/{photoId} (BMASA Batch Photo Gallery)
    // -------------------------------------------------------------------------
    match /gallery_photos/{photoId} {
      allow get: if isValidId(photoId) && isSignedIn() && (
        existing().isPublished == true || isAdmin()
      );

      allow list: if isSignedIn() && existing().isPublished == true;

      allow create: if isValidId(photoId) &&
        isVerifiedUser() &&
        isValidGalleryPhoto(incoming()) &&
        incoming().uploadedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isValidId(photoId) &&
        isVerifiedUser() &&
        isValidGalleryPhoto(incoming()) &&
        incoming().uploadedByUid == existing().uploadedByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'batch',
          'title',
          'description',
          'photoUrl',
          'isPublished',
          'updatedAt'
        ]);

      allow delete: if isValidId(photoId) && isVerifiedUser() && isAdmin();
    }
  }
}
