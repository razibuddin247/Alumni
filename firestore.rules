              'academicQualifications',
              'nokName',
              'nokRelation',
              'nokPhone',
              'nokCity',
              'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'email',
              'phone',
              'whatsapp',
              'academyName',
              'passportNumber',
              'passportIssueDate',
              'bankAccountHolder',
              'bankName',
              'bankBranch',
              'bankAccountNumber',
              'bankRoutingNumber',
              'mfsNumber',
              'passportExpiry',
              'cdcIssueDate',
              'cdcExpiry',
              'medicalExpiry',
              'stcwCocExpiry',
              'academicQualifications',
              'nokName',
              'nokRelation',
              'nokPhone',
              'nokCity',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(memberId) && isVerifiedUser() && (isOwner(memberId) || isAdmin());

      match /cop_certificates/{certId} {
        allow get: if isValidId(memberId) && isValidId(certId) && (isOwner(memberId) || isAdmin());
        allow list: if isValidId(memberId) && isOwner(memberId);

        allow create: if isValidId(memberId) &&
          isValidId(certId) &&
          isVerifiedUser() &&
          isValidCopCertificate(incoming(), memberId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isOwner(memberId) || isAdmin()) &&
          exists(/databases/$(database)/documents/private_vault/$(memberId));

        allow update: if isValidId(memberId) &&
          isValidId(certId) &&
          isVerifiedUser() &&
          isValidCopCertificate(incoming(), memberId) &&
          incoming().memberId == existing().memberId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (isOwner(memberId) || isAdmin()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'certNumber',
            'issueDate',
            'expiryDate',
            'isStandard',
            'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/private_vault/$(memberId));

        allow delete: if isValidId(memberId) &&
          isValidId(certId) &&
          isVerifiedUser() &&
          (isOwner(memberId) || isAdmin()) &&
          exists(/databases/$(database)/documents/private_vault/$(memberId));
      }
    }

    // -------------------------------------------------------------------------
    // Legacy Collection: /directory_profiles/{memberId} (Retained for Migration)
    // -------------------------------------------------------------------------
    match /directory_profiles/{memberId} {
      allow get: if isValidId(memberId) && (
        (isSignedIn() && existing().isPublicDirectory == true) ||
        isOwner(memberId) ||
        isAdmin()
      );

      allow list: if isSignedIn() && existing().isPublicDirectory == true;

      allow create: if isValidId(memberId) &&
        isVerifiedUser() &&
        isValidDirectoryProfile(incoming()) &&
        incoming().uid == memberId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(memberId) && incoming().isVerified == false) ||
          isAdmin()
        );

      allow update: if isValidId(memberId) &&
        isVerifiedUser() &&
        isValidDirectoryProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(memberId) &&
            incoming().isVerified == existing().isVerified &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName',
              'photoUrl',
              'cadetNumber',
              'batch',
              'department',
              'cdcNumber',
              'sidNumber',
              'currentRank',
              'availabilityStatus',
              'cvUrl',
              'memberSerial',
              'isPublicDirectory',
              'voyageCount',
              'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isVerified',
              'fullName',
              'photoUrl',
              'cadetNumber',
              'batch',
              'department',
              'cdcNumber',
              'sidNumber',
              'currentRank',
              'availabilityStatus',
              'cvUrl',
              'memberSerial',
              'isPublicDirectory',
              'voyageCount',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(memberId) && isVerifiedUser() && (isOwner(memberId) || isAdmin());

      match /voyages/{voyageId} {
        allow get: if isValidId(memberId) && isValidId(voyageId) && isSignedIn() && (
          isOwner(memberId) || isAdmin()
        ) && exists(/databases/$(database)/documents/directory_profiles/$(memberId));

        allow list: if isSignedIn() && (
          isOwner(memberId) || existing().memberId == request.auth.uid || isMainAdmin()
        );

        allow create: if isValidId(memberId) &&
          isValidId(voyageId) &&
          isVerifiedUser() &&
          isValidVoyageRecord(incoming(), memberId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isOwner(memberId) || isAdmin()) &&
          exists(/databases/$(database)/documents/directory_profiles/$(memberId));

        allow update: if isValidId(memberId) &&
          isValidId(voyageId) &&
          isVerifiedUser() &&
          isValidVoyageRecord(incoming(), memberId) &&
          incoming().memberId == existing().memberId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (
              isOwner(memberId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'vesselName',
                'vesselType',
                'companyName',
                'rankServed',
                'signOnDate',
                'signOffDate',
                'isVisible',
                'updatedAt'
              ])
            ) ||
            (
              isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'vesselName',
                'vesselType',
                'companyName',
                'rankServed',
                'signOnDate',
                'signOffDate',
                'isVisible',
